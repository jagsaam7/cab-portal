# --- Maps and GPS (all optional). The defaults use free public servers, fine for testing and light use. ---
# Centre of your city, used to bias address search and as the first map view (latitude,longitude).
MAP_CENTER=12.9716,77.5946
# Road routing (distance, time, route line). Default is the public OSRM demo server.
OSRM_URL=https://router.project-osrm.org
# Address search (OpenStreetMap data). Default is the public Photon server.
GEO_URL=https://photon.komoot.io
# Drivers farther than this many km from the pickup are not asked (default 25).
MAX_PICKUP_KM=25
# Multiplies road time to allow for traffic (default 1.3).
TRAFFIC_FACTOR=1.3
